{
  "name": "content-helper",
  "productName": "Content Helper",
  "version": "0.8.0",
  "description": "XXL Desktop-Werkzeugkasten für Creator: Multi-Plattform-Planung, Scheduling, Ideenmaschine, Analytics und Coaching – komplett lokal.",
  "main": "src/main/main.js",
  "author": "MoinMornhart",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir",
    "lint": "node scripts/check-syntax.js",
    "test:companion": "node scripts/test-companion.js",
    "test:connectors": "node scripts/test-connectors.js",
    "test:calendar": "node scripts/test-calendar.js",
    "test:sync": "node scripts/test-sync.js",
    "test:publish": "node scripts/test-publish.js && node scripts/test-providers.js",
    "pretest": "node scripts/check-syntax.js && node scripts/test-companion.js && node scripts/test-connectors.js && node scripts/test-calendar.js && node scripts/test-sync.js && node scripts/test-publish.js && node scripts/test-providers.js",
    "test": "electron scripts/smoke-test.js",
    "icons": "node scripts/make-icon.js",
    "screenshots": "electron scripts/screenshots.js"
  },
  "build": {
    "appId": "de.mornhart.contenthelper",
    "productName": "Content Helper",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "MoinMornhart",
        "repo": "content-helper",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Content Helper"
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
