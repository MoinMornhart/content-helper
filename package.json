{
  "name": "content-helper",
  "productName": "Content Helper",
  "version": "0.1.0",
  "description": "XXL Desktop-Werkzeugkasten für Creator: Multi-Plattform-Planung, Scheduling, Ideenmaschine, Analytics und Coaching – komplett lokal.",
  "main": "src/main/main.js",
  "author": "MoinMornhart",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir",
    "lint": "node scripts/check-syntax.js",
    "pretest": "node scripts/check-syntax.js",
    "test": "electron scripts/smoke-test.js",
    "icons": "node scripts/make-icon.js"
  },
  "build": {
    "appId": "de.mornhart.contenthelper",
    "productName": "Content Helper",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Content Helper"
    }
  },
  "devDependencies": {
    "electron": "^44.3.0"
  }
}
